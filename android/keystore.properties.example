# Copy this file to `keystore.properties` (git-ignored) to sign release builds.
#
# Generate a keystore once with:
#   keytool -genkeypair -v -keystore starfall-release.keystore \
#     -alias starfall -keyalg RSA -keysize 2048 -validity 10000
#
# The same values can instead be supplied as environment variables, which is
# what the GitHub Actions workflow uses:
#   SF_STORE_FILE, SF_STORE_PASSWORD, SF_KEY_ALIAS, SF_KEY_PASSWORD

storeFile=../starfall-release.keystore
storePassword=changeme
keyAlias=starfall
keyPassword=changeme
